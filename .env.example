YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_REGION=IN
PORT=3000
# Netscape-format cookies exported from a signed-in browser.
# For Render, set YOUTUBE_COOKIES_BASE64 to base64(cookies.txt).
# In PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("cookies.txt"))
# Keep the exported cookies private; do not commit them or paste them into chat.
YOUTUBE_COOKIES_BASE64=
